# Không bao giờ điền seed, mật khẩu sàn, hay mã 2FA vào file này.

# paper | live  (live chỉ khi có API trade-only, tắt Withdraw)
TRADING_MODE=paper

# Sàn: binance | bybit | okx
CEX_ID=binance
CEX_API_KEY=
CEX_API_SECRET=
# OKX cần thêm
CEX_PASSWORD=

# Telegram: tạo bot qua @BotFather, lấy token. Không share công khai.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RPC công cộng (tuỳ chọn, để xem số dư ví)
EVM_RPC_URL=https://rpc.ankr.com/eth

# Vốn paper ban đầu (USD)
PAPER_CASH_USD=1000
