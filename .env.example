# Không bao giờ điền seed, mật khẩu sàn, hay mã 2FA vào file này.

# paper | live  — live chỉ khi CẢ 3: TRADING_MODE=live + I_ACCEPT_LIVE_TRADING=yes + API trade-only
TRADING_MODE=paper
I_ACCEPT_LIVE_TRADING=no

# Sàn: binance | bybit | okx
CEX_ID=binance
CEX_API_KEY=
CEX_API_SECRET=
# OKX cần thêm
CEX_PASSWORD=

# Trần tiền thật (USDT). Bắt đầu nhỏ.
LIVE_MAX_USDT=40
LIVE_MAX_ORDER_USDT=12
LIVE_MIN_ORDER_USDT=6

# Telegram: tạo bot qua @BotFather. Không share công khai.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RPC công cộng (tuỳ chọn)
EVM_RPC_URL=https://rpc.ankr.com/eth

# Vốn paper (USD giả)
PAPER_CASH_USD=1000
